# Meera's Railway Delay API - server configuration
# Copy this file to .env and fill in your own values. NEVER commit real keys.

# Address that receives x402 payments (your Base Sepolia wallet address)
SELLER_ADDRESS=

# Payment network - MUST stay on the Base Sepolia testnet (eip155:84532).
# The server refuses to start with any other value.
NETWORK=eip155:84532

# x402 facilitator. Defaults to the official facilitator if unset.
FACILITATOR_URL=https://x402.org/facilitator

# Server-side request body size limit in bytes (default 16384 = 16 KiB)
BODY_LIMIT_BYTES=16384

# Maximum accepted notice length in characters (default 4096)
NOTICE_MAX_LENGTH=4096

# Server-controlled prices in testnet USDC (the client cannot change these)
PRICE_BASIC=$0.01
PRICE_PREMIUM=$0.05

# HTTP port (default 3000)
PORT=3000

# Buyer only: private key of a Base Sepolia test wallet with testnet USDC.
# Never commit this value. Get testnet USDC from a Base Sepolia faucet.
BUYER_PRIVATE_KEY=

# Buyer only: URL of the running server
SERVER_URL=http://localhost:3000
